{
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "gradleCommand": ":app:assembleDebug"
            }
        },
        "preview": {
            "distribution": "internal",
            "ios": {
                "simulator": true
            }
        },
        "preview-apk": {
            "android": {
                "buildType": "apk"
            }
        },
        "preview-assemble": {
            "android": {
                "gradleCommand": ":app:assembleRelease"
            }
        },
        "production": {
            "android": {
                "gradleCommand": ":app:assembleRelease"
            }
        }
    }
}
