{
  "version": "1.0.13",
  "scripts": {
    "start": "expo start --dev-client",
    "start-prod": "expo start --no-dev --minify",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "prebuild": "npx expo prebuild",
    "lint": "eslint app/**/*.js database/*.js",
    "lint-fix": "eslint *.js **/*.js app/**/*.js database/*.js --fix",
    "build-android": "eas build -p android",
    "build-ios": "eas build -p ios",
    "build-android-apk": "eas build -p android --profile preview-apk",
    "build-all": "eas build --platform all",
    "build-ios-simulator": "eas build -p ios --profile preview",
    "build-ios-archive": "expo build:ios -t archive",
    "raise-version": "npx react-native-version --never-amend && git add . && git commit -m raised-version && npm version patch",
    "run-android": "eas build --profile development --platform android",
    "run-ios": "eas build --profile development --platform ios",
    "run-android-device": "eas build:run -p android",
    "run-ios-device": "eas build:run -p ios"
  },
  "dependencies": {
    "@expo/webpack-config": "^18.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.2.0",
    "@react-native-community/hooks": "^3.0.0",
    "@react-native-firebase/app": "^11.5.0",
    "@react-navigation/bottom-tabs": "^6.5.7",
    "@react-navigation/drawer": "^6.6.2",
    "@react-navigation/material-bottom-tabs": "^6.2.15",
    "@react-navigation/native": "^6.1.6",
    "@react-navigation/stack": "^6.3.16",
    "cryptocurrency-icons": "^0.18.1",
    "expo": "^52.0.30",
    "expo-auth-session": "~6.0.3",
    "expo-clipboard": "~7.0.1",
    "expo-dev-client": "~5.0.11",
    "expo-google-app-auth": "~8.3.0",
    "expo-linear-gradient": "~14.0.2",
    "expo-splash-screen": "~0.29.21",
    "expo-sqlite": "~15.1.2",
    "expo-status-bar": "~2.0.1",
    "firebase": "^9.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.6",
    "react-native-elements": "^3.4.3",
    "react-native-firebase": "^5.6.0",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-google-mobile-ads": "^9.1.2",
    "react-native-ico-material-design": "^3.3.1",
    "react-native-numeric-input": "^1.9.1",
    "react-native-paper": "^5.2.0",
    "react-native-progress": "^5.0.0",
    "react-native-radio-buttons-group": "^2.3.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-vector-icons": "^9.2.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.21.0",
    "babel-eslint": "^10.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.35.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-native": "^4.0.0"
  },
  "private": true,
  "name": "TTM"
